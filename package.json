{
  "name": "animated-portfolio",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "next build",
    "start": "next start --hostname 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "prepare:media": "node scripts/prepare-media.mjs",
    "check:deployment": "node scripts/check-deployment.mjs",
    "verify": "node scripts/verify-pages.mjs && node scripts/verify-accessibility-motion.mjs && node scripts/verify-hover-reset.mjs",
    "build:release": "npm run check:deployment && next build"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "next": "^16.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "ffmpeg-static": "^5.2.0",
    "typescript": "^5.9.0"
  }
}
